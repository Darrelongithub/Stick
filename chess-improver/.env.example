# Coach layer (optional)
#
# Copy to `.env` in chess-improver/. The server rereads this file on each coach
# status/ask request, so adding, changing, or removing a key takes effect on
# the next browser refresh. A real process environment variable still wins over
# the file. The value is never copied into Vite, the browser bundle, or any API
# response.
# Without a key, the same Stockfish knowledge is answered by the deterministic
# local coach so the app still works offline.
#
# Get a key from Google AI Studio. `ADAPT_GEMINI_API_KEY` is also accepted for
# consistency with the owner's Adapt repo.
GEMINI_API_KEY=
# ADAPT_GEMINI_API_KEY=

# Rolling aliases are preferred: versioned Gemini IDs get retired without
# notice. `GEMINI_MODEL_FALLBACK` is tried first if the configured model 404s.
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_FALLBACK=gemini-flash-lite-latest
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Free-tier guardrails, mirroring the Adapt client.
GEMINI_TIMEOUT_MS=20000
GEMINI_DAILY_CALL_BUDGET=120
GEMINI_MIN_INTERVAL_MS=700
