<?xml version="1.0" encoding="UTF-8" ?>
<Mascot xmlns="http://www.group-finity.com/Mascot" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.group-finity.com/Mascot Mascot.xsd">

	<BehaviorList>
	
		<!-- ALWAYS REQUIRED -->
		<Behavior Name="ChaseMouse" Frequency="0" Hidden="true">
			<NextBehavior Add="false">
				<BehaviorReference Name="SitAndFaceMouse" Frequency="0"  Hidden="true"/>
			</NextBehavior>
		</Behavior>
		
		<Behavior Name="SitAndFaceMouse" Frequency="0" Hidden="true">
			<NextBehavior Add="false">
				<BehaviorReference Name="SitAndFaceMouse" Frequency="0"  Hidden="true"/>
				<BehaviorReference Name="SitWhileDanglingLegs" Frequency="0"  Hidden="true"/>
			</NextBehavior>
		</Behavior>
		
		<!-- ALWAYS REQUIRED -->
		<Behavior Name="Fall" Frequency="0" Hidden="true" />
		
		<!-- ALWAYS REQUIRED -->
		<Behavior Name="Dragged" Frequency="0" Hidden="true" />
		
		<!-- ALWAYS REQUIRED -->
		<Behavior Name="Thrown" Frequency="0" Hidden="true" />
		
		<Behavior Name="PullUp" Frequency="0" Hidden="true" />
		
		<Behavior Name="Trip" Frequency="0"  Hidden="true"/>

		<!-- AvA custom behaviors (Stick pack generator) -->

		<!-- AvA custom behaviors (Stick pack generator) -->

		<Behavior Name="HuggingSolid" Frequency="0" Hidden="true" />
		<Behavior Name="HuggedSolid" Frequency="0" Hidden="true" />

		<!-- On the Floor -->
		<Condition Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}">
			<Behavior Name="StandUp" Frequency="0" Hidden="true" />
			<Behavior Name="SitDown" Frequency="0" Hidden="true">
				<NextBehavior Add="true">
					<BehaviorReference Name="SitWhileDanglingLegs" Frequency="0"  Hidden="true"/>
					<BehaviorReference Name="LieDown" Frequency="0"  Hidden="true"/>
				</NextBehavior>
			</Behavior>
			<Behavior Name="SitWhileDanglingLegs" Frequency="0"  Hidden="true"/>
			<Behavior Name="LieDown" Frequency="0" Hidden="true">
				<NextBehavior Add="false">
					<BehaviorReference Name="SitDown" Frequency="0"  Hidden="true"/>
				</NextBehavior>
			</Behavior>
			<Behavior Name="HugAffordance" Frequency="0"  Hidden="true"/>
			<Behavior Name="HugSearch" Frequency="0"  Hidden="true"/>
		</Condition>

		<!-- On the Wall -->
		<Condition Condition="#{ mascot.lookRight ? (
					mascot.environment.workArea.rightBorder.isOn(mascot.anchor) || 
					mascot.environment.activeIE.leftBorder.isOn(mascot.anchor) ) : (
					mascot.environment.workArea.leftBorder.isOn(mascot.anchor) || 
					mascot.environment.activeIE.rightBorder.isOn(mascot.anchor) ) }">
			<Behavior Name="HoldOntoWall" Frequency="0" Hidden="true" />
			<Behavior Name="FallFromWall" Frequency="0" Condition="${!mascot.environment.floor.isOn(mascot.anchor)}" Hidden="true" />
		</Condition>
		
		<!-- On the Ceiling -->
		<Condition Condition="#{mascot.environment.ceiling.isOn(mascot.anchor) || mascot.environment.activeIE.bottomBorder.isOn(mascot.anchor)}">
			<Behavior Name="HoldOntoCeiling" Frequency="0" Hidden="true" />
			<Behavior Name="FallFromCeiling" Frequency="0" Hidden="true" />
		</Condition>
		
		<!-- On Work Area Floor -->
		<Condition Condition="#{mascot.environment.floor.isOn(mascot.anchor)}">
			<Behavior Name="WalkAlongWorkAreaFloor" Frequency="0" Hidden="true" />
			<Behavior Name="RunAlongWorkAreaFloor" Frequency="0" Hidden="true" />
			<Behavior Name="WalkLeftAlongFloorAndSit" Frequency="0" Hidden="true" />
			<Behavior Name="WalkRightAlongFloorAndSit" Frequency="0" Hidden="true" />
			<Behavior Name="GrabWorkAreaBottomLeftWall" Frequency="0" Hidden="true" />
			<Behavior Name="GrabWorkAreaBottomRightWall" Frequency="0" Hidden="true" />
			<Behavior Name="WalkLeftAndSit" Frequency="0" Hidden="true" />
			<Behavior Name="WalkRightAndSit" Frequency="0" Hidden="true" />
			<Behavior Name="RunAndGrabBottomLeftWall" Frequency="0"  Hidden="true"/>
			<Behavior Name="RunAndGrabBottomRightWall" Frequency="0"  Hidden="true"/>
		</Condition>
		
		<!-- On Work Area Facing the Wall -->
		<Condition Condition="#{mascot.lookRight ? mascot.environment.workArea.rightBorder.isOn(mascot.anchor) :
					mascot.environment.workArea.leftBorder.isOn(mascot.anchor)}">
			<Behavior Name="ClimbHalfwayAlongWall" Frequency="0" Hidden="true" />
			<Behavior Name="ClimbAlongWall" Frequency="0"  Hidden="true"/>
		</Condition>
		
		<!-- On Work Area Top Facing -->
		<Condition Condition="#{mascot.environment.ceiling.isOn(mascot.anchor)}">
			<!-- Only Blue does this. Good arm strength -->
			<Behavior Name="ClimbAlongCeiling" Frequency="0"  Hidden="true"/>
		</Condition>
		
		<!-- On Top of IE -->
		<Condition Condition="#{mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}">
			<Behavior Name="WalkAlongIECeiling" Frequency="0" Hidden="true" />
			<Behavior Name="RunAlongIECeiling" Frequency="0" Hidden="true" />
			<Behavior Name="SitOnTheLeftEdgeOfIE" Frequency="0" Hidden="true" />
			<Behavior Name="SitOnTheRightEdgeOfIE" Frequency="0" Hidden="true" />
			<Behavior Name="JumpFromLeftEdgeOfIE" Frequency="0" Hidden="true" />
			<Behavior Name="JumpFromRightEdgeOfIE" Frequency="0" Hidden="true" />
			<Behavior Name="WalkLeftAlongIEAndSit" Frequency="0" Hidden="true" />
			<Behavior Name="WalkRightAlongIEAndSit" Frequency="0" Hidden="true" />
			<Behavior Name="WalkLeftAlongIEAndJump" Frequency="0" Hidden="true" />
			<Behavior Name="WalkRightAlongIEAndJump" Frequency="0" Hidden="true" />
		</Condition>
		
		<!-- On IE's Side -->
		<Condition Condition="#{mascot.lookRight ? mascot.environment.activeIE.leftBorder.isOn(mascot.anchor) :
					mascot.environment.activeIE.rightBorder.isOn(mascot.anchor)}">
			<Behavior Name="HoldOntoIEWall" Frequency="0" Hidden="true" />
			<Behavior Name="ClimbIEWall" Frequency="0" Hidden="true" />
			
		</Condition>

		<!-- On the Bottom of IE -->
		<Condition Condition="#{mascot.environment.activeIE.bottomBorder.isOn(mascot.anchor)}">
			<Behavior Name="ClimbIEBottom" Frequency="0" Hidden="true" />
			<Behavior Name="GrabIEBottomLeftWall" Frequency="0" Hidden="true" />
			<Behavior Name="GrabIEBottomRightWall" Frequency="0" Hidden="true" />
		</Condition>
		<!-- AVA:generated:behaviors:start -->
		<Behavior Name="Dance" Frequency="3" Condition="#{mascot.environment.floor.isOn(mascot.anchor)}" />
		<Behavior Name="SpinKick" Frequency="8" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="Stretch" Frequency="16" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="Bonk" Frequency="6" />
		<Behavior Name="Meditate" Frequency="13" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="Crawl" Frequency="8" Condition="#{mascot.environment.floor.isOn(mascot.anchor)}" />
		<Behavior Name="Phone" Frequency="10" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="Coffee" Frequency="13" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="Sneeze" Frequency="6" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="Victory" Frequency="9" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="ReadBook" Frequency="16" />
		<Behavior Name="Walk" Frequency="24" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="PowerSlide" Frequency="8" />
		<Behavior Name="Mine" Frequency="10" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="Cry" Frequency="5" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="FightCombo" Frequency="11" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="Juggle" Frequency="7" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="SnackTime" Frequency="10" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="Wave" Frequency="24" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="BrewPotion" Frequency="25" />
		<Behavior Name="Jump" Frequency="10" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="GlitchOut" Frequency="6" />
		<Behavior Name="BattleRage" Frequency="7" />
		<Behavior Name="Run" Frequency="12" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="CursorSlash" Frequency="16" />
		<Behavior Name="PaperPlane" Frequency="8" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="Dizzy" Frequency="4" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="PushUps" Frequency="7" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="SwordPractice" Frequency="12" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="Idle" Frequency="14" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="Hurt" Frequency="8" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="Cheer" Frequency="11" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="Backflip" Frequency="10" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="Sleep" Frequency="20" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<Behavior Name="Taunt" Frequency="10" Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}" />
		<!-- AVA:generated:behaviors:end -->
	</BehaviorList>
</Mascot>
