		<Behavior Name="CursorSlash" Frequency="16" Condition="#{Math.abs(mascot.anchor.x - mascot.environment.cursor.x) &lt; 300 &amp;&amp; Math.abs(mascot.anchor.y - mascot.environment.cursor.y) &lt; 300 &amp;&amp; (function(){try{return String(mascot.getBehavior()) != 'Behavior(CursorSlash)' &amp;&amp; String(mascot.getBehavior()) != 'Behavior[name=CursorSlash]';}catch(ex){return true;}})()}" />
