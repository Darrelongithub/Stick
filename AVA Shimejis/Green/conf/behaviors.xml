<?xml version="1.0" encoding="UTF-8" ?>
<Mascot xmlns="http://www.group-finity.com/Mascot" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.group-finity.com/Mascot Mascot.xsd">

	<BehaviorList>
	
		<!-- ALWAYS REQUIRED -->
		<Behavior Name="ChaseMouse" Frequency="0" Hidden="true">
			<NextBehavior Add="false">
				<BehaviorReference Name="SitAndFaceMouse" Frequency="1" />
			</NextBehavior>
		</Behavior>
		
		<Behavior Name="SitAndFaceMouse" Frequency="8">
			<NextBehavior Add="false">
				<BehaviorReference Name="SitAndFaceMouse" Frequency="100" />
				<BehaviorReference Name="SitWhileDanglingLegs" Frequency="1" />
			</NextBehavior>
		</Behavior>
		
		<!-- ALWAYS REQUIRED -->
		<Behavior Name="Fall" Frequency="0" Hidden="true" />
		
		<!-- ALWAYS REQUIRED -->
		<Behavior Name="Dragged" Frequency="0" Hidden="true" />
		
		<!-- ALWAYS REQUIRED -->
		<Behavior Name="Thrown" Frequency="0" Hidden="true" />
		
		<Behavior Name="PullUp" Frequency="0" Hidden="true" />
		
		<Behavior Name="Trip" Frequency="10" />

		<!-- AvA custom behaviors (Stick pack generator) -->

		<!-- AvA custom behaviors (Stick pack generator) -->

		<Behavior Name="HuggingSolid" Frequency="0" Hidden="true" />
		<Behavior Name="HuggedSolid" Frequency="0" Hidden="true" />

		<!-- On the Floor -->
		<Condition Condition="#{mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}">
			<Behavior Name="StandUp" Frequency="20" Hidden="true" />
			<Behavior Name="SitDown" Frequency="16">
				<NextBehavior Add="true">
					<BehaviorReference Name="SitWhileDanglingLegs" Frequency="100" />
					<BehaviorReference Name="LieDown" Frequency="100" />
				</NextBehavior>
			</Behavior>
			<Behavior Name="SitWhileDanglingLegs" Frequency="14" />
			<Behavior Name="LieDown" Frequency="8">
				<NextBehavior Add="false">
					<BehaviorReference Name="SitDown" Frequency="100" />
				</NextBehavior>
			</Behavior>
			<Behavior Name="HugAffordance" Frequency="16" />
			<Behavior Name="HugSearch" Frequency="20" />
		</Condition>

		<!-- On the Wall -->
		<Condition Condition="#{ mascot.lookRight ? (
					mascot.environment.workArea.rightBorder.isOn(mascot.anchor) || 
					mascot.environment.activeIE.leftBorder.isOn(mascot.anchor) ) : (
					mascot.environment.workArea.leftBorder.isOn(mascot.anchor) || 
					mascot.environment.activeIE.rightBorder.isOn(mascot.anchor) ) }">
			<Behavior Name="HoldOntoWall" Frequency="100" Hidden="true"  Condition="#{(function(){try{return String(mascot.getBehavior()) != 'Behavior(HoldOntoWall)' &amp;&amp; String(mascot.getBehavior()) != 'Behavior[name=HoldOntoWall]';}catch(ex){return true;}})()}">
				<NextBehaviorList Add="false">
					<BehaviorReference Name="ClimbAlongWall" Frequency="40" Condition="#{(function(){try{return (mascot.lookRight ? mascot.environment.workArea.rightBorder.isOn(mascot.anchor) : mascot.environment.workArea.leftBorder.isOn(mascot.anchor)) &amp;&amp; mascot.anchor.y &gt; mascot.environment.workArea.top+64;}catch(ex){return true;}})()}" />
					<BehaviorReference Name="ClimbHalfwayAlongWall" Frequency="40" Condition="#{(function(){try{return (mascot.lookRight ? mascot.environment.workArea.rightBorder.isOn(mascot.anchor) : mascot.environment.workArea.leftBorder.isOn(mascot.anchor)) &amp;&amp; mascot.anchor.y &gt; mascot.environment.workArea.top+64;}catch(ex){return true;}})()}" />
					<BehaviorReference Name="FallFromWall" Frequency="20" Condition="#{(function(){try{return !mascot.environment.floor.isOn(mascot.anchor);}catch(ex){return true;}})()}" />
				</NextBehaviorList>
			</Behavior>
			<Behavior Name="FallFromWall" Frequency="50" Condition="${!mascot.environment.floor.isOn(mascot.anchor)}" Hidden="true" />
		</Condition>
		
		<!-- On the Ceiling -->
		<Condition Condition="#{mascot.environment.ceiling.isOn(mascot.anchor) || mascot.environment.activeIE.bottomBorder.isOn(mascot.anchor)}">
			<Behavior Name="HoldOntoCeiling" Frequency="100" Hidden="true"  Condition="#{(function(){try{return String(mascot.getBehavior()) != 'Behavior(HoldOntoCeiling)' &amp;&amp; String(mascot.getBehavior()) != 'Behavior[name=HoldOntoCeiling]';}catch(ex){return true;}})()}" />
			<Behavior Name="FallFromCeiling" Frequency="50" Hidden="true" />
		</Condition>
		
		<!-- On Work Area Floor -->
		<Condition Condition="#{mascot.environment.floor.isOn(mascot.anchor)}">
			<Behavior Name="WalkAlongWorkAreaFloor" Frequency="27" Hidden="true" />
			<Behavior Name="RunAlongWorkAreaFloor" Frequency="27" Hidden="true" />
			<Behavior Name="WalkLeftAlongFloorAndSit" Frequency="8" Hidden="true" />
			<Behavior Name="WalkRightAlongFloorAndSit" Frequency="13" Hidden="true" />
			<Behavior Name="GrabWorkAreaBottomLeftWall" Frequency="7" Hidden="true" />
			<Behavior Name="GrabWorkAreaBottomRightWall" Frequency="10" Hidden="true" />
			<Behavior Name="WalkLeftAndSit" Frequency="12" Hidden="true" />
			<Behavior Name="WalkRightAndSit" Frequency="6" Hidden="true" />
			<Behavior Name="RunAndGrabBottomLeftWall" Frequency="9" />
			<Behavior Name="RunAndGrabBottomRightWall" Frequency="14" />
		</Condition>
		
		<!-- On Work Area Facing the Wall -->
		<Condition Condition="#{mascot.lookRight ? mascot.environment.workArea.rightBorder.isOn(mascot.anchor) :
					mascot.environment.workArea.leftBorder.isOn(mascot.anchor)}">
			<Behavior Name="ClimbHalfwayAlongWall" Frequency="20" Hidden="true" />
			<Behavior Name="ClimbAlongWall" Frequency="24" />
		</Condition>
		
		<!-- On Work Area Top Facing -->
		<Condition Condition="#{mascot.environment.ceiling.isOn(mascot.anchor)}">
			<!-- Only Blue does this. Good arm strength -->
			<Behavior Name="ClimbAlongCeiling" Frequency="28" />
		</Condition>
		
		<!-- On Top of IE -->
		<Condition Condition="#{mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}">
			<Behavior Name="WalkAlongIECeiling" Frequency="9" Hidden="true" />
			<Behavior Name="RunAlongIECeiling" Frequency="13" Hidden="true" />
			<Behavior Name="SitOnTheLeftEdgeOfIE" Frequency="6" Hidden="true" />
			<Behavior Name="SitOnTheRightEdgeOfIE" Frequency="12" Hidden="true" />
			<Behavior Name="JumpFromLeftEdgeOfIE" Frequency="100" Hidden="true" />
			<Behavior Name="JumpFromRightEdgeOfIE" Frequency="100" Hidden="true" />
			<Behavior Name="WalkLeftAlongIEAndSit" Frequency="7" Hidden="true" />
			<Behavior Name="WalkRightAlongIEAndSit" Frequency="11" Hidden="true" />
			<Behavior Name="WalkLeftAlongIEAndJump" Frequency="10" Hidden="true" />
			<Behavior Name="WalkRightAlongIEAndJump" Frequency="5" Hidden="true" />
		</Condition>
		
		<!-- On IE's Side -->
		<Condition Condition="#{mascot.lookRight ? mascot.environment.activeIE.leftBorder.isOn(mascot.anchor) :
					mascot.environment.activeIE.rightBorder.isOn(mascot.anchor)}">
			<Behavior Name="HoldOntoIEWall" Frequency="100" Hidden="true" />
			<Behavior Name="ClimbIEWall" Frequency="100" Hidden="true" />
			
		</Condition>

		<!-- On the Bottom of IE -->
		<Condition Condition="#{mascot.environment.activeIE.bottomBorder.isOn(mascot.anchor)}">
			<Behavior Name="ClimbIEBottom" Frequency="100" Hidden="true" />
			<Behavior Name="GrabIEBottomLeftWall" Frequency="100" Hidden="true" />
			<Behavior Name="GrabIEBottomRightWall" Frequency="100" Hidden="true" />
		</Condition>
		<!-- AVA:generated:behaviors:start -->
